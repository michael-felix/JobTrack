# Postgres connection used by Prisma. When running via `docker compose up`, the
# app container talks to the `db` service; when running Next.js directly on the
# host (e.g. `npm run dev` outside Docker), point this at localhost instead:
#   postgresql://jobtrack:jobtrack@localhost:5432/jobtrack
DATABASE_URL=postgresql://jobtrack:jobtrack@db:5432/jobtrack

# Used to sign/verify session cookies. Generate a real random value for any
# non-local environment, e.g.: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me

# Where uploaded resume/cover-letter files are written (local-disk storage
# implementation). Must be a writable, persisted volume.
UPLOAD_DIR=./uploads

# Anthropic API key for the "generate tailored résumé/cover letter" feature
# (src/lib/document-generation.ts). Create one with billing enabled at
# https://console.anthropic.com — this is separate from any Claude Code
# subscription. Leaving it unset just disables that one feature; everything
# else keeps working.
ANTHROPIC_API_KEY=
