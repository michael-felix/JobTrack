# Postgres connection used by Prisma. When running via `docker compose up`, the
# app container talks to the `db` service; when running Next.js directly on the
# host (e.g. `npm run dev` outside Docker), point this at localhost instead:
#   postgresql://jobtrack:jobtrack@localhost:5432/jobtrack
DATABASE_URL=postgresql://jobtrack:jobtrack@db:5432/jobtrack

# Used to sign/verify session cookies. Generate a real random value for any
# non-local environment, e.g.: openssl rand -base64 32
SESSION_SECRET=dev-session-secret-change-me

# Where uploaded resume/cover-letter files are written (local-disk storage
# implementation). Must be a writable, persisted volume.
UPLOAD_DIR=./uploads

# Anthropic API key for the "generate tailored résumé/cover letter" feature
# (src/lib/document-generation.ts). Create one with billing enabled at
# https://console.anthropic.com — this is separate from any Claude Code
# subscription. Leaving it unset just disables that one feature; everything
# else keeps working.
ANTHROPIC_API_KEY=

# Encrypts the Gmail refresh token at rest (src/lib/crypto.ts). Must decode
# to exactly 32 bytes; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# OAuth client for the Gmail "check inbox for rejections" feature
# (src/lib/gmail.ts). Create at https://console.cloud.google.com:
#   1. New project (or reuse one) → APIs & Services → enable "Gmail API".
#   2. OAuth consent screen → User type "External" → keep it in "Testing"
#      publish status and add your own Google account under "Test users".
#      (Testing mode is fully functional for you; publishing it publicly
#      would require Google's CASA security review for the readonly Gmail
#      scope, which isn't worth it for a personal app.)
#   3. Credentials → Create OAuth client ID → Web application → add
#      GOOGLE_REDIRECT_URI below to "Authorized redirect URIs".
# Leaving these unset just disables the feature.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
