generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStage {
  SAVED
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

enum DocumentType {
  RESUME
  COVER_LETTER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  sessions     Session[]
  applications Application[]
  documents    DocumentVersion[]
  apiTokens    ApiToken[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Personal access token used by the Chrome extension. Deliberately a
/// separate credential from Session: it is bearer-authenticated (not a
/// cookie) and is only ever checked by the /api/extension/* routes, which
/// can only create SAVED applications — it cannot reach any other endpoint.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  label      String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Application {
  id                   String           @id @default(cuid())
  userId               String
  jobTitle             String
  company              String
  location             String?
  salary               String?
  jobUrl               String?
  jobDescription       String?
  stage                ApplicationStage @default(SAVED)
  notes                String?
  dateCaptured         DateTime         @default(now())
  followUpDate         DateTime?
  resumeVersionId      String?
  coverLetterVersionId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeVersion DocumentVersion?   @relation("ApplicationResume", fields: [resumeVersionId], references: [id])
  coverLetter   DocumentVersion?   @relation("ApplicationCoverLetter", fields: [coverLetterVersionId], references: [id])
  events        ApplicationEvent[]
  matchScores   MatchScore[]
  interviewPrep InterviewPrep?

  @@index([userId])
  @@index([userId, stage])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  fromStage     ApplicationStage?
  toStage       ApplicationStage
  note          String?
  createdAt     DateTime          @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model DocumentVersion {
  id            String       @id @default(cuid())
  userId        String
  type          DocumentType
  label         String
  fileName      String
  storagePath   String
  extractedText String
  changeSummary String?
  createdAt     DateTime     @default(now())

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationsResume Application[] @relation("ApplicationResume")
  applicationsCover  Application[] @relation("ApplicationCoverLetter")
  matchScores        MatchScore[]

  @@index([userId])
  @@index([userId, type])
}

model MatchScore {
  id                String   @id @default(cuid())
  applicationId     String
  documentVersionId String
  score             Int
  missingKeywords   Json
  missingSkills     Json
  strengths         Json
  createdAt         DateTime @default(now())

  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model InterviewPrep {
  id                  String   @id @default(cuid())
  applicationId       String   @unique
  companyResearch     String?
  technicalQuestions  Json     @default("[]")
  behavioralQuestions Json     @default("[]")
  checklist           Json     @default("[]")
  notes               String?
  updatedAt           DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
